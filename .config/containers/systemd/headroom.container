# Rootless podman unit for the headroom proxy.
# Not enabled: started on demand by ~/.local/bin/headroom-mcp and stopped
# when the last `headroom mcp serve` session exits.
[Unit]
Description=Headroom compression proxy (on-demand, rootless podman)
After=network-online.target

[Container]
Image=ghcr.io/headroomlabs-ai/headroom:latest
ContainerName=headroom-proxy
PublishPort=127.0.0.1:8787:8787
Environment=HEADROOM_HOST=0.0.0.0
Environment=HEADROOM_MODE=token
Environment=HEADROOM_TELEMETRY=off
Environment=HEADROOM_ALLOW_UNAUTHENTICATED_BIND=1
Environment=OPENAI_TARGET_API_URL=https://opencode.ai/zen/go/v1
Environment=HEADROOM_WORKSPACE_DIR=/home/nonroot/.headroom
Volume=headroom-workspace:/home/nonroot/.headroom
HealthCmd=curl --fail --silent http://127.0.0.1:8787/readyz
HealthInterval=30s
HealthStartPeriod=45s
HealthRetries=3

[Service]
Restart=no
TimeoutStartSec=180
