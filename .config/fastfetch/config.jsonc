{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "CachyOS_small",
    "padding": { "top": 2, "left": 2, "right": 2 }
  },

  // Keys are space-padded to 8 chars so every ':' lines up.
  "modules": [

    { "type": "custom", "format": "\u001b[32m┌─ Hardware ───────────────────────────────────┐\u001b[0m" },
    { "type": "cpu", "key": "│ 󰻠 CPU     ", "keyColor": "green" },
    { "type": "gpu", "key": "│ 󰾲 GPU     ", "keyColor": "green" },
    { "type": "memory", "key": "│ 󰍛 Memory  ", "keyColor": "green" },
    { "type": "custom", "format": "\u001b[32m└──────────────────────────────────────────────┘\u001b[0m" },

    { "type": "custom", "format": "\u001b[33m┌─ System ─────────────────────────────────────┐\u001b[0m" },
    { "type": "kernel", "key": "│  Kernel  ", "keyColor": "yellow" },
    { "type": "packages", "key": "│ 󰏖 Packages", "keyColor": "yellow" },
    { "type": "uptime", "key": "│ 󰥔 Uptime  ", "keyColor": "yellow" },
    { "type": "custom", "format": "\u001b[33m└──────────────────────────────────────────────┘\u001b[0m" },

    { "type": "custom", "format": "\u001b[34m┌─ Desktop ────────────────────────────────────┐\u001b[0m" },
    { "type": "wm", "key": "│  WM      ", "keyColor": "blue" },
    { "type": "shell", "key": "│  Shell   ", "keyColor": "blue" },
    { "type": "command", "key": "│ 󰛖 Font    ", "keyColor": "blue", "text": "printf \"%s · %s\" \"$(gsettings get org.gnome.desktop.interface font-name | sed \"s/'//g\")\" \"$(gsettings get org.gnome.desktop.interface monospace-font-name | sed \"s/'//g\")\"" },
    { "type": "custom", "format": "\u001b[34m└──────────────────────────────────────────────┘\u001b[0m" },

    // Palette swatch only.
    { "type": "command", "key": " ", "format": "{}", "text": "printf '\u001b[30m\u25cf \u001b[31m\u25cf \u001b[32m\u25cf \u001b[33m\u25cf \u001b[34m\u25cf \u001b[35m\u25cf \u001b[36m\u25cf \u001b[37m\u25cf'" }
  ]
}
