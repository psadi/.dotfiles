#!/bin/sh
# Start the headroom proxy on demand, then run the MCP server.
# Stops the proxy again when the last MCP session exits.
ready=http://127.0.0.1:8787/readyz

if ! curl -sf -o /dev/null "$ready" 2>/dev/null; then
    systemctl --user start headroom.service 2>/dev/null || true
    i=0
    while [ "$i" -lt 60 ]; do
        curl -sf -o /dev/null "$ready" 2>/dev/null && break
        sleep 0.5
        i=$((i+1))
    done
fi

headroom mcp serve &
child=$!
trap 'kill "$child" 2>/dev/null' INT TERM
wait "$child"
rc=$?

if ! pgrep -f 'headroom mcp serve' >/dev/null 2>&1; then
    systemctl --user stop headroom.service 2>/dev/null || true
fi
exit "$rc"
