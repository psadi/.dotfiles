#!/usr/bin/env bash
# niri-menu — nested, categorised fuzzel menu.
# Top level stays short; each row lists its keywords so typing "wifi" or
# "display" jumps straight to the right category.
set -euo pipefail

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a niri "$1" "${2:-}" || true; }
ICON=$'\0icon\x1f'
pick() { fuzzel --dmenu --prompt "${1:-niri> }" --lines 15; }

wifi_state()     { [ "$(nmcli radio wifi 2>/dev/null)" = enabled ] && echo on || echo off; }
bt_state()       { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo on || echo off; }
caffeine_state() { pgrep -f 'systemd-inhibit --what=idle --who=niri-caffeine' >/dev/null 2>&1 && echo on || echo off; }
airplane_state() { rfkill list 2>/dev/null | grep -q 'Soft blocked: yes' && echo on || echo off; }
profile()        { powerprofilesctl get 2>/dev/null || echo n/a; }
night_state()    { pgrep -x wlsunset >/dev/null && echo on || echo off; }
outputs()        { niri msg --json outputs 2>/dev/null | jq -r 'keys | join(" + ")'; }

# ── System ───────────────────────────────────────────────────────────────────
system_menu() {
    while :; do
        choice=$(printf '%s\n' \
            "Wi-Fi: toggle (now $(wifi_state))${ICON}network-wireless" \
            "Wi-Fi: connect…${ICON}network-wireless" \
            "Bluetooth: toggle (now $(bt_state))${ICON}bluetooth" \
            "Bluetooth: devices…${ICON}bluetooth" \
            "Airplane mode: toggle (now $(airplane_state))${ICON}airplane-mode" \
            "Caffeine: toggle (now $(caffeine_state))${ICON}caffeine" \
            "Night light: toggle (now $(night_state))${ICON}night-light" \
            "Notifications: DND toggle${ICON}notifications" \
            "Back${ICON}go-previous" | pick "system> ") || return 0
        case "$choice" in
            "Wi-Fi: toggle"*)      if [ "$(wifi_state)" = on ]; then nmcli radio wifi off; notify "Wi-Fi off"; else nmcli radio wifi on; notify "Wi-Fi on"; fi ;;
            "Wi-Fi: connect"*)     "$HOME/.local/bin/niri-wifi-menu" ;;
            "Bluetooth: toggle"*)  if [ "$(bt_state)" = on ]; then bluetoothctl power off >/dev/null; notify "Bluetooth off"; else bluetoothctl power on >/dev/null; notify "Bluetooth on"; fi ;;
            "Bluetooth: devices"*) "$HOME/.local/bin/niri-bt-menu" ;;
            "Airplane"*)           if [ "$(airplane_state)" = on ]; then rfkill unblock all; notify "Airplane off"; else rfkill block all; notify "Airplane on"; fi ;;
            "Caffeine"*)           "$HOME/.local/bin/niri-caffeine" ;;
            "Night light"*)        if pgrep -x wlsunset >/dev/null; then pkill -x wlsunset; notify "Night light off"; else setsid wlsunset -t 4000 -T 6500 >/dev/null 2>&1 </dev/null & disown; notify "Night light on"; fi ;;
            "Notifications"*)      makoctl mode -t do-not-disturb >/dev/null 2>&1 && notify "Notifications" "DND toggled" ;;
            *) return 0 ;;
        esac
    done
}

# ── Power ────────────────────────────────────────────────────────────────────
power_menu() {
    while :; do
        choice=$(printf '%s\n' \
            "Profile: performance${ICON}battery" \
            "Profile: balanced${ICON}battery" \
            "Profile: power-saver${ICON}battery" \
            "Battery status${ICON}battery" \
            "Suspend${ICON}system-suspend" \
            "Power menu…${ICON}system-shutdown" \
            "Back${ICON}go-previous" | pick "power> ") || return 0
        case "$choice" in
            "Profile: performance") powerprofilesctl set performance; notify "Power profile" performance ;;
            "Profile: balanced")    powerprofilesctl set balanced;    notify "Power profile" balanced ;;
            "Profile: power-saver") powerprofilesctl set power-saver; notify "Power profile" power-saver ;;
            "Battery status")
                bat=$(upower -e 2>/dev/null | grep -m1 BAT || true)
                [ -n "$bat" ] && notify "Battery" "$(upower -i "$bat" | grep -E 'state|percentage|time to' | tr -s ' ' | paste -sd ' ' -)" ;;
            "Suspend") systemctl suspend ;;
            "Power menu…") "$HOME/.local/bin/niri-power-menu" ;;
            *) return 0 ;;
        esac
    done
}

# ── Tools ────────────────────────────────────────────────────────────────────
tools_menu() {
    while :; do
        choice=$(printf '%s\n' \
            "Files (yazi)${ICON}folder" \
            "Terminal (ghostty)${ICON}utilities-terminal" \
            "System monitor (btm)${ICON}utilities-system-monitor" \
            "Calendar (calcurse)${ICON}x-office-calendar" \
            "Clipboard history${ICON}edit-paste" \
            "Screenshot (area)${ICON}camera-photo" \
            "Disk manager (gparted)${ICON}drive-harddisk" \
            "Keybindings (nvim)${ICON}preferences-desktop-keyboard" \
            "Back${ICON}go-previous" | pick "tools> ") || return 0
        case "$choice" in
            "Files (yazi)")        niri-term yazi ;;
            "Terminal (ghostty)")  ghostty ;;
            "System monitor"*)     niri-term btm ;;
            "Calendar"*)           niri-term calcurse ;;
            "Clipboard"*)          cliphist list | fuzzel --dmenu --prompt 'clipboard> ' | cliphist decode | wl-copy ;;
            "Screenshot"*)         "$HOME/.local/bin/niri-screenshot" screenshot ;;
            "Disk manager"*)       gparted ;;
            "Keybindings"*)        niri-term nvim "$HOME/.config/niri/config.kdl" ;;
            *) return 0 ;;
        esac
    done
}

# ── Session ──────────────────────────────────────────────────────────────────
session_menu() {
    local choice
    choice=$(printf '%s\n' \
        "Lock${ICON}system-lock-screen" \
        "Log out${ICON}system-log-out" \
        "Reboot…${ICON}system-reboot" \
        "Power off…${ICON}system-shutdown" \
        "Back${ICON}go-previous" | pick "session> ") || return 0
    case "$choice" in
        "Lock")       "$HOME/.local/bin/niri-lock" ;;
        "Log out")    niri msg action quit ;;
        "Reboot…")    "$HOME/.local/bin/niri-confirm-power" reboot ;;
        "Power off…") "$HOME/.local/bin/niri-confirm-power" poweroff ;;
        *) return 0 ;;
    esac
}

# ── Main (short list, keywords make it searchable) ───────────────────────────
while :; do
    choice=$(printf '%s\n' \
        "Apps — launch, browser${ICON}system-run" \
        "System — wifi, bluetooth, airplane, caffeine, night light, DND${ICON}preferences-system" \
        "Audio — volume, output, input, mixer${ICON}audio-volume-high" \
        "Display — arrange, monitors, scale${ICON}video-display" \
        "Power — profile, battery, suspend${ICON}battery" \
        "Session — lock, logout, reboot, shutdown${ICON}system-log-out" \
        "Tools — files, terminal, monitor, calendar, clipboard, screenshot${ICON}utilities-terminal" | pick "niri> ") || exit 0

    case "$choice" in
        "Apps"*)    fuzzel ;;
        "System"*)  system_menu ;;
        "Audio"*)   "$HOME/.local/bin/niri-volume-menu" ;;
        "Display"*) "$HOME/.local/bin/niri-display-menu" ;;
        "Power"*)   power_menu ;;
        "Session"*) session_menu ;;
        "Tools"*)   tools_menu ;;
        *) exit 0 ;;
    esac
done
