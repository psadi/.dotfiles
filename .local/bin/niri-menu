#!/usr/bin/env bash
# niri-menu — fuzzel-driven control menu (no terminal needed).
set -euo pipefail

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a niri "$1" "${2:-}" || true; }
pick() { fuzzel --dmenu --prompt "${1:-}> " --lines 12; }

wifi_state()     { [ "$(nmcli radio wifi 2>/dev/null)" = enabled ] && echo on || echo off; }
bt_state()       { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo on || echo off; }
caffeine_state() { pgrep -f 'systemd-inhibit --what=idle --who=niri-caffeine' >/dev/null 2>&1 && echo on || echo off; }
airplane_state() { rfkill list 2>/dev/null | grep -q 'Soft blocked: yes' && echo on || echo off; }

system_menu() {
    while :; do
        local choice
        choice=$(printf '%s\n' \
            "Wi-Fi: toggle (now $(wifi_state))" \
            "Wi-Fi: connect…" \
            "Bluetooth: toggle (now $(bt_state))" \
            "Bluetooth: devices…" \
            "Airplane: toggle (now $(airplane_state))" \
            "Caffeine: toggle (now $(caffeine_state))" \
            "Night light: toggle" \
            "Back" | pick "system") || choice=""

        case "$choice" in
            "Wi-Fi: toggle"*)
                if [ "$(wifi_state)" = on ]; then nmcli radio wifi off; notify "Wi-Fi off"; else nmcli radio wifi on; notify "Wi-Fi on"; fi ;;
            "Wi-Fi: connect…")
                "$HOME/.local/bin/niri-wifi-menu" ;;
            "Bluetooth: toggle"*)
                if [ "$(bt_state)" = on ]; then bluetoothctl power off >/dev/null; notify "Bluetooth off"; else bluetoothctl power on >/dev/null; notify "Bluetooth on"; fi ;;
            "Bluetooth: devices…")
                "$HOME/.local/bin/niri-bt-menu" ;;
            "Airplane: toggle"*)
                if [ "$(airplane_state)" = on ]; then rfkill unblock all; notify "Airplane off"; else rfkill block all; notify "Airplane on"; fi ;;
            "Caffeine: toggle"*)
                "$HOME/.local/bin/niri-caffeine" ;;
            "Night light: toggle")
                if pgrep -x wlsunset >/dev/null; then pkill -x wlsunset; notify "Night light off"; else setsid wlsunset -t 4000 -T 6500 >/dev/null 2>&1 </dev/null & disown || true; notify "Night light on"; fi ;;
            "Back"|"") return 0 ;;
        esac
    done
}

power_menu() {
    local choice
    choice=$(printf '%s\n' \
        "Profile: performance" \
        "Profile: balanced" \
        "Profile: power-saver" \
        "Battery status" \
        "Suspend" \
        "Back" | pick "power") || choice=""

    case "$choice" in
        "Profile: performance") powerprofilesctl set performance; notify "Power profile" "performance" ;;
        "Profile: balanced")    powerprofilesctl set balanced;    notify "Power profile" "balanced" ;;
        "Profile: power-saver") powerprofilesctl set power-saver; notify "Power profile" "power-saver" ;;
        "Battery status")
            local bat
            bat=$(upower -e 2>/dev/null | grep -m1 BAT || true)
            if [ -n "$bat" ]; then notify "Battery" "$(upower -i "$bat" | grep -E 'state|percentage|time to empty' | tr -s ' ' | paste -sd ' ' -)"; else notify "Battery" "no battery found"; fi ;;
        "Suspend") systemctl suspend ;;
        "Back"|"") return 0 ;;
    esac
}

settings_menu() {
    local choice
    choice=$(printf '%s\n' \
        "Network (Wi-Fi networks)" \
        "Bluetooth (devices)" \
        "Audio (volume)" \
        "System monitor (btm)" \
        "Calendar (calcurse)" \
        "Network (nmtui, advanced)" \
        "Displays (niri outputs)" \
        "Keybindings (niri config)" \
        "Back" | pick "settings") || choice=""

    case "$choice" in
        "Network (Wi-Fi networks)") "$HOME/.local/bin/niri-wifi-menu" ;;
        "Bluetooth (devices)")      "$HOME/.local/bin/niri-bt-menu" ;;
        "Audio (volume)")           "$HOME/.local/bin/niri-volume-menu" ;;
        "System monitor (btm)")    niri-term btm ;;
        "Calendar (calcurse)")     niri-term calcurse ;;
        "Network (nmtui, advanced)") niri-term nmtui ;;
        "Displays (niri outputs)")  niri-term sh -c 'niri msg outputs; echo; read -r -p "press enter"' ;;
        "Keybindings (niri config)") niri-term nvim "$HOME/.config/niri/config.kdl" ;;
        "Back"|"") return 0 ;;
    esac
}

main_menu() {
    while :; do
        local choice
        choice=$(printf '%s\n' \
            "Apps" \
            "System" \
            "Power" \
            "Settings" \
            "Files (yazi)" \
            "Lock" \
            "Logout" \
            "Reboot" \
            "Shutdown" | pick "niri") || exit 0

        case "$choice" in
            "Apps")          fuzzel ;;
            "System")        system_menu ;;
            "Power")         "$HOME/.local/bin/niri-power-menu" ;;
            "Settings")      settings_menu ;;
            "Files (yazi)")  niri-term yazi ;;
            "Lock")          exec "$HOME/.local/bin/niri-lock" ;;
            "Logout")        niri msg action quit ;;
            "Reboot")        systemctl reboot ;;
            "Shutdown")      systemctl poweroff ;;
            *)               exit 0 ;;
        esac
    done
}

main_menu "$@"
