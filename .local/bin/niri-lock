#!/usr/bin/env bash
# Kanagawa-themed session lock for niri (swaylock).
# Shows a lock symbol on a plain Kanagawa background; no text.
set -euo pipefail

exec swaylock -f \
  --image "$HOME/.local/share/backgrounds/lock-kanagawa.png" \
  --scaling fill \
  --text-color dcd7ba \
  --inside-color 1f1f28cc \
  --ring-color 363646 \
  --ring-ver-color 7e9cd8 \
  --ring-wrong-color e82424 \
  --key-hl-color 7aa89f \
  --bs-hl-color e82424 \
  --line-color 00000000 \
  --separator-color 00000000 \
  --font "Geist" \
  --indicator-radius 120 \
  --indicator-thickness 8
