#!/usr/bin/env bash
# Kanagawa session lock for niri.
# Prefer hyprlock (its "Locked" placeholder fades out while typing);
# fall back to swaylock with the Kanagawa lock image.
set -euo pipefail

if command -v hyprlock >/dev/null 2>&1; then
    hyprlock --config "$HOME/.config/hypr/hyprlock.conf" && exit 0
fi

exec swaylock -f \
  --image "$HOME/.local/share/backgrounds/lock-kanagawa.png" \
  --scaling fill \
  --text-color dcd7ba \
  --inside-color 1f1f28cc \
  --ring-color 363646 \
  --ring-ver-color 7e9cd8 \
  --ring-wrong-color e82424 \
  --key-hl-color 7aa89f \
  --bs-hl-color e82424 \
  --line-color 00000000 \
  --separator-color 00000000 \
  --font "GeistMono NF" \
  --indicator-radius 120 \
  --indicator-thickness 8
